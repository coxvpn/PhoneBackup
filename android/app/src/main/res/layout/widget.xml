<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="8dp">

    
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="7.2" android:gravity="center_vertical" android:orientation="horizontal">

        <LinearLayout android:id="@+id/weather_box" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="5" android:orientation="vertical">

            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2" android:orientation="horizontal">
                <TextView android:id="@+id/weather" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" android:ellipsize="end" android:gravity="center_vertical|start" android:maxLines="1" android:textColor="@color/widget_text" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="54sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold" />
                <LinearLayout android:id="@+id/minmax" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="2" android:orientation="vertical">
                    <TextView android:id="@+id/temp_high" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical|start" android:maxLines="1" android:textColor="@color/widget_up" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp" />
                    <TextView android:id="@+id/temp_low" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical|start" android:maxLines="1" android:textColor="@color/widget_down" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <TextView android:id="@+id/aqi" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:textColor="#FFFFFF" android:textStyle="bold" android:visibility="gone" android:textSize="13sp" />
                <TextView android:id="@+id/city_label" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="10dp" android:ellipsize="end" android:gravity="center_vertical|end" android:maxLines="1" android:singleLine="true" android:textColor="@color/widget_dim" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/info" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="5" android:background="@drawable/panel_auto" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:orientation="vertical">
            <TextView android:id="@+id/date" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.2" android:ellipsize="end" android:gravity="center_vertical|right" android:maxLines="1" android:textColor="@color/widget_text" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/date2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical|right" android:maxLines="1" android:textColor="@color/widget_dim" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/occasion" android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="0.8" android:layout_gravity="right" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" android:paddingStart="8dp" android:paddingEnd="8dp" android:visibility="gone" />
          <LinearLayout android:id="@+id/prayer_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical|right" android:orientation="horizontal">
                <TextView android:id="@+id/prayer_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/widget_prayer" android:textSize="13sp" />
                <Chronometer android:id="@+id/prayer_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textColor="@color/widget_prayer" android:textStyle="bold" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        </LinearLayout>

    
    <LinearLayout android:id="@+id/flag_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.5" android:orientation="horizontal">
        <TextView android:id="@+id/flag" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:ellipsize="end" android:gravity="center_vertical|end" android:maxLines="1" android:textColor="@color/widget_text" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="24sp" android:autoSizeStepGranularity="1sp" />
        <TextView android:id="@+id/country" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" android:ellipsize="end" android:gravity="center_vertical|start" android:maxLines="1" android:textColor="@color/widget_text" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp" android:layout_marginStart="6dp" android:textStyle="bold" />
    <TextView android:id="@+id/ip" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3.6" android:ellipsize="end" android:gravity="center_vertical|start" android:maxLines="1" android:textColor="@color/widget_text" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp" android:layout_marginStart="6dp" />

    </LinearLayout>

    <LinearLayout android:id="@+id/clock_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3.4" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextClock android:id="@+id/clock" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:gravity="center" android:maxLines="1" android:textColor="@color/widget_text" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="80sp" android:autoSizeStepGranularity="1sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.6" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/flag2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:maxLines="1" android:textColor="@color/widget_text" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/country2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="@color/widget_text" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/detail" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.8" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_dim" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" android:gravity="center" />

    
    <LinearLayout android:id="@+id/extra" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2" android:orientation="horizontal">
        
        <LinearLayout android:id="@+id/cell_rate" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:layout_weight="1" android:background="@drawable/rate_bg" android:orientation="vertical">
            <TextView android:id="@+id/lbl_rate" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="@color/rate_label" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/rate" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.5" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="@color/rate_value" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold" />
        </LinearLayout>
        
        <LinearLayout android:id="@+id/cell_wifi" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/lbl_wifi" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="@color/widget_dim" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/wifi" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.5" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="@color/widget_text" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold" />
        </LinearLayout>
        
        <LinearLayout android:id="@+id/cell_sim" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/lbl_sim" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="@color/widget_dim" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/sim" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.5" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="@color/widget_text" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold" />
        </LinearLayout>
    <TextView android:id="@+id/refresh" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="4dp" android:background="@drawable/btn_bg" android:contentDescription="@string/refresh" android:gravity="center" android:text="↻" android:textColor="@color/widget_text" android:textSize="16sp" android:layout_gravity="center_vertical" />
    </LinearLayout>
</LinearLayout>