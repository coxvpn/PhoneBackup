<Window x:Class="PhoneBackup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Resources/app.ico"
        Width="1000" Height="700" MinWidth="820" MinHeight="520"
        FontFamily="Segoe UI, Tahoma" FontSize="14"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- نوار بالا: وضعیت گوشی + زبان + آپدیت + مشخصات + درباره -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="DeviceDot" Width="14" Height="14" Fill="Gray" VerticalAlignment="Center" />
                    <TextBlock x:Name="DeviceText" Margin="10,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <TextBlock x:Name="LangLabel" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox x:Name="LangBox" Width="100" Margin="4,0" SelectionChanged="Lang_Changed">
                    <ComboBoxItem Content="English" />
                    <ComboBoxItem Content="فارسی" />
                </ComboBox>
                <Button x:Name="UpdateBtn" Padding="10,4" Margin="4,0" Click="Update_Click" />
                <Button x:Name="InfoBtn" Padding="10,4" Margin="4,0" IsEnabled="False" Click="Info_Click" />
                <Button x:Name="AboutBtn" Padding="10,4" Margin="4,0" Click="About_Click" />
            </StackPanel>
        </Grid>

        <!-- در حالت عادی: خلاصه‌ی مشخصات گوشی (جزئیات کامل در Phone info) -->
        <GroupBox x:Name="GrpSummary" Grid.Row="1" Padding="10" Margin="0,0,0,10">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
        </GroupBox>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FolderLabel" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="FolderBox" Grid.Column="1" Padding="4" FlowDirection="LeftToRight" />
            <Button x:Name="BrowseBtn" Grid.Column="2" Padding="12,4" Margin="8,0,0,0" Click="Browse_Click" />
        </Grid>

        <WrapPanel Grid.Row="3" Margin="0,0,0,10">
            <Button x:Name="BackupBtn" Padding="20,8" Margin="0,0,10,4" IsEnabled="False" Click="Backup_Click" />
            <Button x:Name="RestoreBtn" Padding="20,8" Margin="0,0,10,4" IsEnabled="False" Click="Restore_Click" />
            <Button x:Name="TransferBtn" Padding="20,8" Margin="0,0,10,4" IsEnabled="False" Click="Transfer_Click" />
            <Button x:Name="CancelBtn" Padding="20,8" Margin="0,0,10,4" IsEnabled="False" Click="Cancel_Click" />
            <Button x:Name="OpenFolderBtn" Padding="20,8" Margin="0,0,10,4" Click="OpenFolder_Click" />
        </WrapPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <ProgressBar x:Name="Progress" Height="8" />
            <TextBlock x:Name="StatusText" Margin="0,4,0,0" Foreground="#555" />
        </StackPanel>

        <TextBox x:Name="LogBox" Grid.Row="5" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Background="#FAFAFA" MinHeight="150" />
    </Grid>
</Window>
