<Window x:Class="PhoneBackup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Resources/app.ico"
        Width="920" Height="900" MinWidth="740" MinHeight="700"
        FontFamily="Segoe UI, Tahoma" FontSize="14"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="140" />
        </Grid.RowDefinitions>

        <!-- نوار بالا: وضعیت گوشی + زبان + آپدیت + درباره -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="DeviceDot" Width="14" Height="14" Fill="Gray" VerticalAlignment="Center" />
                    <TextBlock x:Name="DeviceText" Margin="10,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <TextBlock x:Name="LangLabel" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox x:Name="LangBox" Width="100" Margin="4,0" SelectionChanged="Lang_Changed">
                    <ComboBoxItem Content="English" />
                    <ComboBoxItem Content="فارسی" />
                </ComboBox>
                <Button x:Name="UpdateBtn" Padding="10,4" Margin="4,0" Click="Update_Click" />
                <Button x:Name="InfoBtn" Padding="10,4" Margin="4,0" IsEnabled="False" Click="Info_Click" />
                <Button x:Name="AboutBtn" Padding="10,4" Margin="4,0" Click="About_Click" />
            </StackPanel>
        </Grid>

        <GroupBox x:Name="GrpWhat" Grid.Row="1" Padding="8" Margin="0,0,0,10">
            <WrapPanel>
                <CheckBox x:Name="ChkApps" IsChecked="False" Margin="0,0,24,0" />
                <CheckBox x:Name="ChkMedia" IsChecked="False" Margin="0,0,24,0" />
                <CheckBox x:Name="ChkContacts" IsChecked="False" Margin="0,0,24,0" />
                <CheckBox x:Name="ChkSms" IsChecked="False" />
            </WrapPanel>
        </GroupBox>

        <GroupBox x:Name="GrpMedia" Grid.Row="2" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="92">
                    <ItemsControl x:Name="FolderList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Display}" Margin="0,0,18,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button x:Name="RefreshFoldersBtn" Grid.Column="1" Padding="10,4" Margin="10,0,0,0"
                        VerticalAlignment="Top" IsEnabled="False" Click="RefreshFolders_Click" />
            </Grid>
        </GroupBox>

        <GroupBox x:Name="GrpApps" Grid.Row="3" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,8">
                    <Button x:Name="LoadAppsBtn" Padding="12,4" Margin="0,0,8,4" IsEnabled="False" Click="LoadApps_Click" />
                    <Button x:Name="InstallFolderBtn" Padding="12,4" Margin="0,0,8,4" IsEnabled="False" Click="InstallFolder_Click" />
                    <Button x:Name="SelAllBtn" Padding="12,4" Margin="0,0,8,4" Click="SelAll_Click" />
                    <Button x:Name="SelNoneBtn" Padding="12,4" Margin="0,0,8,4" Click="SelNone_Click" />
                    <CheckBox x:Name="ShowUserChk" IsChecked="True" VerticalAlignment="Center" Margin="8,0,8,4"
                              Checked="Filter_Changed" Unchecked="Filter_Changed" />
                    <CheckBox x:Name="ShowSystemChk" IsChecked="False" VerticalAlignment="Center" Margin="0,0,8,4"
                              Checked="Filter_Changed" Unchecked="Filter_Changed" />
                    <Button x:Name="UninstallBtn" Padding="12,4" Margin="0,0,8,4" Foreground="#B00020" IsEnabled="False"
                            Click="Uninstall_Click" />
                    <TextBlock x:Name="SearchLabel" VerticalAlignment="Center" Margin="8,0,6,4" />
                    <TextBox x:Name="SearchBox" Width="170" Padding="3" Margin="0,0,8,4" TextChanged="Search_Changed" />
                    <TextBlock x:Name="AppCountText" VerticalAlignment="Center" Margin="8,0,0,4" Foreground="#555" />
                </WrapPanel>
                <ListView x:Name="AppList" Grid.Row="1" MinHeight="120">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="44">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="240" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Width="240" DisplayMemberBinding="{Binding Package}" />
                            <GridViewColumn Width="120" DisplayMemberBinding="{Binding TypeText}" />
                            <GridViewColumn Width="80" DisplayMemberBinding="{Binding SizeText}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FolderLabel" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="FolderBox" Grid.Column="1" Padding="4" FlowDirection="LeftToRight" />
            <Button x:Name="BrowseBtn" Grid.Column="2" Padding="12,4" Margin="8,0,0,0" Click="Browse_Click" />
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BackupBtn" Padding="20,8" IsEnabled="False" Click="Backup_Click" />
            <Button x:Name="RestoreBtn" Padding="20,8" Margin="12,0" IsEnabled="False" Click="Restore_Click" />
            <Button x:Name="CancelBtn" Padding="20,8" IsEnabled="False" Click="Cancel_Click" />
            <Button x:Name="OpenFolderBtn" Padding="20,8" Margin="12,0" Click="OpenFolder_Click" />
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="0,0,0,8">
            <ProgressBar x:Name="Progress" Height="8" />
            <TextBlock x:Name="StatusText" Margin="0,4,0,0" Foreground="#555" />
        </StackPanel>

        <TextBox x:Name="LogBox" Grid.Row="7" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Background="#FAFAFA" MinHeight="120" />
    </Grid>
    </ScrollViewer>
</Window>
