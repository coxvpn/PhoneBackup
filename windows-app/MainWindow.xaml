<Window x:Class="PhoneBackup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="پشتیبان‌گیری و بازیابی گوشی اندروید"
        Width="780" Height="700" MinWidth="640" MinHeight="560"
        FlowDirection="RightToLeft" FontFamily="Segoe UI, Tahoma" FontSize="14"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="DeviceDot" Width="14" Height="14" Fill="Red" VerticalAlignment="Center" />
                <TextBlock x:Name="DeviceText" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="در حال جستجوی گوشی..." />
            </StackPanel>
        </Border>

        <GroupBox Grid.Row="1" Header="چه چیزهایی؟" Padding="8" Margin="0,0,0,12">
            <WrapPanel>
                <CheckBox x:Name="ChkApps" Content="برنامه‌ها (فایل نصبی APK)" IsChecked="True" Margin="0,0,24,0" />
                <CheckBox x:Name="ChkMedia" Content="عکس، فیلم و موزیک" IsChecked="True" Margin="0,0,24,0" />
                <CheckBox x:Name="ChkContacts" Content="مخاطبین" IsChecked="True" Margin="0,0,24,0" />
                <CheckBox x:Name="ChkSms" Content="پیامک‌ها" IsChecked="True" />
            </WrapPanel>
        </GroupBox>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="پوشه:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="FolderBox" Grid.Column="1" Padding="4" FlowDirection="LeftToRight" />
            <Button Grid.Column="2" Content="انتخاب..." Padding="12,4" Margin="8,0,0,0" Click="Browse_Click" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BackupBtn" Content="پشتیبان‌گیری از گوشی" Padding="20,8" IsEnabled="False" Click="Backup_Click" />
            <Button x:Name="RestoreBtn" Content="بازیابی روی گوشی" Padding="20,8" Margin="12,0,0,0" IsEnabled="False" Click="Restore_Click" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <ProgressBar x:Name="Progress" Height="8" />
            <TextBlock x:Name="StatusText" Margin="0,4,0,0" Foreground="#555" />
        </StackPanel>

        <TextBox x:Name="LogBox" Grid.Row="5" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Background="#FAFAFA" />
    </Grid>
</Window>
