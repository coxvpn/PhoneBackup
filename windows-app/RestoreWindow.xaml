<Window x:Class="PhoneBackup.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Resources/app.ico"
        Width="660" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI, Tahoma" FontSize="14">
    <StackPanel Margin="16">
        <TextBlock x:Name="HeaderText" TextWrapping="Wrap" Margin="0,0,0,10" />

        <GroupBox x:Name="GrpApps" Padding="8" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel Margin="0,0,0,6">
                    <Button x:Name="AppsAllBtn" Padding="10,3" Margin="0,0,8,0" Click="AppsAll_Click" />
                    <Button x:Name="AppsNoneBtn" Padding="10,3" Click="AppsNone_Click" />
                </WrapPanel>
                <ListBox x:Name="AppsBox" Height="220">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Display}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </GroupBox>

        <GroupBox x:Name="GrpMedia" Padding="8" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel Margin="0,0,0,6">
                    <Button x:Name="MediaAllBtn" Padding="10,3" Margin="0,0,8,0" Click="MediaAll_Click" />
                    <Button x:Name="MediaNoneBtn" Padding="10,3" Click="MediaNone_Click" />
                </WrapPanel>
                <ListBox x:Name="MediaBox" Height="130">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Display}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </GroupBox>

        <TextBlock x:Name="AlsoText" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#555" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkBtn" IsDefault="True" Padding="24,6" Click="Ok_Click" />
            <Button x:Name="CancelBtn" IsCancel="True" Padding="24,6" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
