<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PhoneBackup</AssemblyName>
    <RootNamespace>PhoneBackup</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\helper.apk" LogicalName="helper.apk" />
    <EmbeddedResource Include="Resources\adb\*" LogicalName="adb/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
