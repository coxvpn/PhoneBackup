<Window x:Class="PhoneBackup.DeviceInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Resources/app.ico"
        Width="780" Height="780" MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI, Tahoma" FontSize="14">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Margin="0,0,0,8" Foreground="#555" TextWrapping="Wrap" />

        <ListView x:Name="InfoList" Grid.Row="1" MouseDoubleClick="Row_DoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="210" DisplayMemberBinding="{Binding Label}" />
                    <GridViewColumn Width="480">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Width="460" FlowDirection="LeftToRight" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#1E40AF" Margin="0,10,0,2" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
        </ListView>

        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
            <Button x:Name="RefreshBtn" Padding="12,5" Margin="0,0,8,4" Click="Refresh_Click" />
            <Button x:Name="CopyBtn" Padding="12,5" Margin="0,0,8,4" Click="Copy_Click" />
            <Button x:Name="SaveBtn" Padding="12,5" Margin="0,0,8,4" Click="Save_Click" />
            <Button x:Name="ImeiBtn" Padding="12,5" Margin="0,0,8,4" Click="Imei_Click" />
            <Button x:Name="FirmwareBtn" Padding="12,5" Margin="0,0,8,4" Visibility="Collapsed" Click="Firmware_Click" />
            <Button x:Name="CloseBtn" Padding="16,5" Margin="0,0,8,4" IsCancel="True" />
        </WrapPanel>
    </Grid>
</Window>
