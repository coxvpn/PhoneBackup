<Window x:Class="PhoneBackup.DeviceInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Resources/app.ico"
        Width="780" Height="820" MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI, Tahoma" FontSize="14">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Margin="0,0,0,8" Foreground="#555" TextWrapping="Wrap" />

        <ListView x:Name="InfoList" Grid.Row="1" MouseDoubleClick="Row_DoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="210" DisplayMemberBinding="{Binding Label}" />
                    <GridViewColumn Width="480">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Width="460" FlowDirection="LeftToRight" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#1E40AF" Margin="0,10,0,2" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
        </ListView>

        <GroupBox x:Name="GrpActions" Grid.Row="2" Padding="8" Margin="0,10,0,0">
            <WrapPanel>
                <Button x:Name="RecoveryBtn" Padding="12,5" Margin="0,0,8,4" Click="Recovery_Click" />
                <Button x:Name="DownloadModeBtn" Padding="12,5" Margin="0,0,8,4" Click="DownloadMode_Click" />
                <Button x:Name="FactoryResetBtn" Padding="12,5" Margin="0,0,8,4" Foreground="#B00020" Click="FactoryReset_Click" />
                <Button x:Name="CscGuideBtn" Padding="12,5" Margin="0,0,8,4" Click="CscGuide_Click" />
            </WrapPanel>
        </GroupBox>

        <GroupBox x:Name="GrpOdin" Grid.Row="3" Padding="8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="OdinPathLabel" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="OdinPathBox" Grid.Column="1" Padding="4" IsReadOnly="True" FlowDirection="LeftToRight" />
                <Button x:Name="OdinBrowseBtn" Grid.Column="2" Padding="10,4" Margin="8,0,0,0" Click="OdinBrowse_Click" />
                <Button x:Name="OdinLaunchBtn" Grid.Column="3" Padding="10,4" Margin="8,0,0,0" Click="OdinLaunch_Click" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Margin="0,6,0,0">
                    <Hyperlink x:Name="OdinSourceLink" Click="OdinSource_Click"><Run x:Name="OdinSourceRun" /></Hyperlink>
                </TextBlock>
            </Grid>
        </GroupBox>

        <WrapPanel Grid.Row="4" Margin="0,10,0,0">
            <Button x:Name="RefreshBtn" Padding="12,5" Margin="0,0,8,4" Click="Refresh_Click" />
            <Button x:Name="CopyBtn" Padding="12,5" Margin="0,0,8,4" Click="Copy_Click" />
            <Button x:Name="SaveBtn" Padding="12,5" Margin="0,0,8,4" Click="Save_Click" />
            <Button x:Name="ImeiBtn" Padding="12,5" Margin="0,0,8,4" Click="Imei_Click" />
            <Button x:Name="FirmwareBtn" Padding="12,5" Margin="0,0,8,4" Visibility="Collapsed" Click="Firmware_Click" />
            <Button x:Name="CloseBtn" Padding="16,5" Margin="0,0,8,4" IsCancel="True" />
        </WrapPanel>
    </Grid>
</Window>
